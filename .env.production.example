DJANGO_SECRET_KEY=wsIOP0bjnq...
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=spiderhub.cedia.edu.ec,localhost,127.0.0.1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=spider_user
POSTGRES_PASSWORD=spider_password
POSTGRES_DB=spider

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Superuser (optional - for automated setup)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# Optional: override bundle identity (defaults to digest of staticfiles.json).
# BUILD_ID=custom-deploy-label
#
# Do NOT set STATIC_VERSION unless you need a fixed label; leave unset so Django
# can use GIT_COMMIT_HASH from the Docker image. The API exposes build_id
# (manifest digest) for VersionCheckService so new static assets trigger reload
# even when the git commit is unchanged.
# STATIC_VERSION=1.0.0
CSP_REPORT_URI=https://spiderhub.cedia.edu.ec/csp-report/
