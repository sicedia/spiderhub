@startuml
skinparam componentStyle rectangle
title SPIDERHUB System Architecture

package "Docker Compose" {
  component "spider-web\n(Web Service)" as Web
  database "PostgreSQL\nContainer" as DB
}

Web --> DB : "psycopg2 over TCP\n(port 5432)"

Web -> "WSGI/ASGI\n(config/wsgi.py,\nconfig/asgi.py)" : serve HTTP / WebSocket

package "Django Project" {
  component "manage.py\n(Django CLI)" as CLI
  Web ..> CLI : invokes

  package config {
    component "settings/\n(base, dev, prod)" as Settings
    component "urls.py" as URLs
  }
  Web --> Settings
  Web --> URLs

  package apps {
    component core
    component documents
    component search
    component admin_panel
  }
  Web --> core
  Web --> documents
  Web --> search
  Web --> admin_panel

  folder "data/\n(seed files)" as Data
  Web --> Data : "seed command"

  folder static as Static
  folder templates as Templates
  Web --> Static
  Web --> Templates
}

@enduml