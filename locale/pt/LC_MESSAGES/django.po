msgstr "Conservação e uso sustentável dos oceanos, dos mares e dos recursos marinhos"

#: .\apps\core\constants.py:23
msgid "Life on Land"
msgstr "Vida Terrestre"

#: .\apps\core\constants.py:23
msgid "Protect, restore and promote sustainable use of ecosystems"
msgstr "Proteger, recuperar e promover o uso sustentável dos ecossistemas terrestres"

#: .\apps\core\constants.py:24
msgid "Peace & Justice"
msgstr "Paz, Justiça e Instituições Eficazes"

#: .\apps\core\constants.py:24
msgid "Promote peaceful and inclusive societies for sustainable development"
msgstr "Promover sociedades pacíficas e inclusivas para o desenvolvimento sustentável"

#: .\apps\core\constants.py:25
msgid "Partnerships"
msgstr "Parcerias e Meios de Implementação"

#: .\apps\core\constants.py:25
msgid "Strengthen global partnership for sustainable development"
msgstr "Fortalecer os meios de implementação e revitalizar a parceria global"

