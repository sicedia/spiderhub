msgstr "Erradicação da Pobreza"

#: .\apps\core\constants.py:9
msgid "End poverty in all its forms everywhere"
msgstr "Acabar com a pobreza em todas as suas formas, em todos os lugares"

#: .\apps\core\constants.py:10
msgid "Zero Hunger"
msgstr "Fome Zero e Agricultura Sustentável"

#: .\apps\core\constants.py:10
msgid "End hunger, achieve food security and improved nutrition"
msgstr "Acabar com a fome, alcançar a segurança alimentar e melhoria da nutrição"

#: .\apps\core\constants.py:11
msgid "Good Health"
msgstr "Saúde e Bem-Estar"

#: .\apps\core\constants.py:11
msgid "Ensure healthy lives and promote well-being for all"
msgstr "Assegurar uma vida saudável e promover o bem-estar para todos"

#: .\apps\core\constants.py:12
