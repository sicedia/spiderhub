msgstr "Assegurar a disponibilidade e gestão sustentável da água"

#: .\apps\core\constants.py:15
msgid "Affordable Energy"
msgstr "Energia Limpa e Acessível"

#: .\apps\core\constants.py:15
msgid "Ensure access to affordable, reliable, sustainable energy"
msgstr "Assegurar o acesso confiável, sustentável, moderno e a preço acessível à energia"

#: .\apps\core\constants.py:16
msgid "Decent Work"
msgstr "Trabalho Decente e Crescimento Econômico"

#: .\apps\core\constants.py:16
